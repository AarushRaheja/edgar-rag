# SEC requires a descriptive User-Agent with contact info
SEC_USER_AGENT="Your Name your.email@example.com"
EDGAR_RAG_DATA=data

# Any OpenAI-compatible chat endpoint (Ollama shown)
LLM_BASE_URL=http://localhost:11434/v1
